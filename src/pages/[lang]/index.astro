---
import { type Lang } from "@/utils/i18n";
import HomePage from "@/components/home/HomePage.astro";

export function getStaticPaths() {
    return [
        { params: { lang: "en" } },
        { params: { lang: "fr" } },
    ];
}

const { lang } = Astro.params as { lang: Lang };
---
<HomePage lang={lang} />
